doctype html
include /data/index
include /mixins/index

html.page(lang='en')
  head
    block meta
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block title
      title= site.name
    block styles
      link(rel='stylesheet', href='/src/styles/main.scss')
  body.page__body
    main
      block content
    block scripts
