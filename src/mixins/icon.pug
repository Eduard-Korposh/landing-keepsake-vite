//- Розміри й viewBox беруться з макета, &attributes дозволяє їх перевизначити
mixin icon(name)
  case name
    when 'heart'
      svg(width='16', height='15', viewBox='0 0 16 15', aria-hidden='true')&attributes(attributes)
        include /includes/icons/heart
    when 'burger'
      svg(width='40', height='40', viewBox='0 0 40 40', aria-hidden='true')&attributes(attributes)
        include /includes/icons/burger
    when 'close'
      svg(width='18', height='18', viewBox='0 0 18 18', aria-hidden='true')&attributes(attributes)
        include /includes/icons/close
    when 'chevron'
      svg(width='6', height='11', viewBox='0.75 0.75 6 11', overflow='visible', aria-hidden='true')&attributes(attributes)
        include /includes/icons/chevron
    when 'mail'
      svg(
        width='14',
        height='10',
        viewBox='0.65 0.65 14 10',
        overflow='visible',
        aria-hidden='true'
      )&attributes(attributes)
        include /includes/icons/mail
    when 'plus'
      svg(width='18', height='18', viewBox='0 0 18 18', aria-hidden='true')&attributes(attributes)
        include /includes/icons/plus
    when 'web-design'
      svg(width='42', height='30', viewBox='0 0 42 30', aria-hidden='true')&attributes(attributes)
        include /includes/icons/web-design
    when 'motion-video'
      svg(width='40', height='32', viewBox='0 0 40 32', aria-hidden='true')&attributes(attributes)
        include /includes/icons/motion-video
    when 'print-design'
      svg(width='42', height='34', viewBox='0 0 42 34', aria-hidden='true')&attributes(attributes)
        include /includes/icons/print-design
    when 'illustration'
      svg.text-accent(width='34', height='31', viewBox='0 0 34 31', aria-hidden='true')&attributes(attributes)
        include /includes/icons/illustration
    when 'quote'
      svg(width='22', height='21', viewBox='0 0 22 21', aria-hidden='true')&attributes(attributes)
        include /includes/icons/quote
    when 'check'
      svg(width='12', height='9', viewBox='0 0 12 9', aria-hidden='true')&attributes(attributes)
        include /includes/icons/check
    when 'arrow-right'
      svg(width='5', height='9', viewBox='0.75 0.75 5 9', overflow='visible', aria-hidden='true')&attributes(attributes)
        include /includes/icons/arrow-right
    when 'arrow-up'
      svg(width='14', height='16', viewBox='0 0 14 16', aria-hidden='true')&attributes(attributes)
        include /includes/icons/arrow-up
    default
      - throw new Error(`Невідома іконка: ${name}`);
