section#about.section(aria-labelledby='about-title')
  .container.section__stack
    h2#about-title.section-title What do we do
    p.text-body
      | We are a small team of designers and makers who help brands look their best online and
      | offline.
    ul.services
      each service in services
        li.service
          span.service__icon
            +icon(service.icon)
          h3.service__title= service.title
          p.service__text= service.text
